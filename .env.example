# Required: At least one LLM provider API key
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GEMINI_API_KEY=your-key-here
# OPENROUTER_API_KEY=your-key-here
# Optional: For web search tool (free tier at tavily.com)
# TAVILY_API_KEY=tvly-your-key-here

# Optional: Database connection
# Default: uses local SQLite file (agent_harness.db) — zero config needed
# Override: set a connection string for external databases
# DATABASE_PATH=agent_harness.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
